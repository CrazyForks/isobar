// Generated by CMake from cmake/isobar.rc.in — do not edit.
//
// Windows resource script. Windows reads an executable's icon and its
// Properties→Details fields from resources compiled INTO the .exe; shipping
// assets/isobar.ico beside the binary does nothing for Explorer. Without this
// file the packaged .exe shows the generic application icon.
//
// Deliberately ASCII-only and free of #include: rc.exe interprets string
// bytes with the system codepage, and the numeric FILEFLAGS/FILEOS constants
// below (the same values winver.h defines) avoid depending on the SDK header
// search path. Both keep the resource compile portable across MSVC and
// MinGW's windres.

// Explorer shows the ICON resource with the lowest numeric id, so this stays
// the only one. Forward slashes: backslashes would be string escapes here.
1 ICON "@CMAKE_SOURCE_DIR@/assets/isobar.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK  0x3fL          // VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L           // release build: no debug/prerelease flags
 FILEOS         0x40004L       // VOS_NT_WINDOWS32
 FILETYPE       0x1L           // VFT_APP
 FILESUBTYPE    0x0L           // VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"       // US English (0x0409), Unicode (1200/0x04b0)
        BEGIN
            VALUE "CompanyName",      "Sara Sakuragawa"
            VALUE "FileDescription",  "@ISOBAR_RC_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@ISOBAR_RC_NAME@"
            VALUE "OriginalFilename", "@ISOBAR_RC_FILENAME@"
            VALUE "ProductName",      "Isobar"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Sara Sakuragawa. GPL v3 or later."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // Must agree with the StringFileInfo block above: 0x0409, 1200.
        VALUE "Translation", 0x409, 1200
    END
END
